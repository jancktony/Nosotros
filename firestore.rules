rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(pairId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/pairs/$(pairId)).data.members;
    }

    // Códigos de vinculación de 6 dígitos (duran 24 h)
    match /codes/{code} {
      allow read, create: if signedIn();
      allow delete: if signedIn();
    }

    match /pairs/{pairId} {
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid];
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // Un miembro puede modificar; o un nuevo integrante puede unirse con el código correcto
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members ||
        (resource.data.members.size() == 1
          && request.resource.data.members.size() == 2
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.joinCode == resource.data.code)
      );

      // Todo lo de adentro (ubicaciones, lugares, eventos, trayectos) solo para la pareja
      match /{document=**} {
        allow read, write: if isMember(pairId);
      }
    }
  }
}
