rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Aplicación personal. El correo verificado viene firmado por Firebase Auth.
    function personal() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'kelinherrera130323@gmail.com', 'jancktoni@gmail.com'
        ];
    }
    function pairData(id) { return get(/databases/$(database)/documents/pairs/$(id)).data; }
    function member(id) { return personal() && request.auth.uid in pairData(id).members; }
    function admin(id) { return member(id) && pairData(id).admin == request.auth.uid; }
    function changedOnly(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }
    function own(data) { return data.uid == request.auth.uid; }
    function validFlags(flags) {
      return flags is map && flags.keys().hasOnly(['walkie', 'voiceNotes', 'map3d', 'profilePhoto', 'compactWidgets', 'placeAlerts', 'manualUpdates', 'autoUpdates', 'lockDetails', 'appPresence', 'sleepStatus', 'mapPlaces', 'mapGlobe', 'walkieRelay', 'findPhone'])
        && flags.get('findPhone', 'off') in ['off', 'admin', 'all']
        && flags.get('appPresence', 'off') in ['off', 'admin', 'all']
        && flags.get('sleepStatus', 'off') in ['off', 'admin', 'all']
        && flags.get('mapPlaces', 'off') in ['off', 'admin', 'all']
        && flags.get('mapGlobe', 'off') in ['off', 'admin', 'all']
        && flags.get('walkieRelay', 'off') in ['off', 'admin', 'all']
        && flags.get('walkie', 'off') in ['off', 'admin', 'all']
        && flags.get('voiceNotes', 'off') in ['off', 'admin', 'all']
        && flags.get('map3d', 'all') in ['off', 'admin', 'all']
        && flags.get('profilePhoto', 'all') in ['off', 'admin', 'all']
        && flags.get('compactWidgets', 'all') in ['off', 'admin', 'all']
        && flags.get('placeAlerts', 'all') in ['off', 'admin', 'all']
        && flags.get('autoUpdates', 'all') in ['off', 'admin', 'all']
        && flags.get('lockDetails', 'all') in ['off', 'admin', 'all']
        && flags.get('manualUpdates', 'all') in ['off', 'admin', 'all']
      ;
    }
    function feature(id, key, fallback) {
      let data = pairData(id);
      let mode = data.get('featureFlags', {}).get(key, fallback);
      return mode == 'all' || (mode == 'admin' && data.admin == request.auth.uid);
    }
    function validProfile(data) {
      return (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 90000))
        && (!('findPhoneEnabled' in data) || data.findPhoneEnabled is bool);
    }
    function validMembers(data) {
      return data.members is list && data.members.size() >= 1 && data.members.size() <= 2
        && data.members.toSet().size() == data.members.size()
        && data.admin in data.members;
    }
    function validCode(data, code) {
      return data.keys().hasOnly(['pairId', 'owner', 'expiresAt'])
        && code.matches('[0-9]{6}') && data.owner == request.auth.uid
        && admin(data.pairId)
        && pairData(data.pairId).code == code
        && data.expiresAt is int
        && data.expiresAt > request.time.toMillis()
        && data.expiresAt <= request.time.toMillis() + 86400000;
    }
    match /releases/{version} {
      allow read: if personal();
      match /chunks/{chunk} {
        function manifest() { return get(/databases/$(database)/documents/releases/$(version)).data; }
        allow read: if personal() && manifest().ready == true && member(manifest().pairId)
          && (admin(manifest().pairId) || pairData(manifest().pairId).get('relVersion', '') == version);
        // Solo CI con la cuenta de servicio puede publicar o borrar bytes.
      }
    }
    match /codes/{code} {
      allow get: if personal();
      allow list: if false;
      allow create: if personal() && validCode(request.resource.data, code);
      allow delete: if personal() && (
        resource.data.owner == request.auth.uid ||
        (member(resource.data.pairId) && pairData(resource.data.pairId).members.size() == 2)
      );
      // No sobrescribir códigos existentes ni modificar su caducidad.
    }
    // Se retira la vinculación anónima: el panel usa las mismas cuentas verificadas.
    match /weblinks/{code} { allow read, write: if false; }

    match /pairs/{id} {
      function validRelease() {
        let before = resource.data.get('relVersion', '');
        let after = request.resource.data.get('relVersion', '');
        return before == after || (after is string && after.matches('[0-9]+([.][0-9]+){1,2}')
          && get(/databases/$(database)/documents/releases/$(after)).data.ready == true
          && get(/databases/$(database)/documents/releases/$(after)).data.pairId == id
          && request.resource.data.get('relUrl', '') == get(/databases/$(database)/documents/releases/$(after)).data.apkPath
          && get(/databases/$(database)/documents/pairs/$(id)/releaseReviews/$(after)).data.state == 'approved'
          && get(/databases/$(database)/documents/pairs/$(id)/releaseReviews/$(after)).data.uid == request.auth.uid
          && get(/databases/$(database)/documents/pairs/$(id)/members/$(request.auth.uid)).data.appVersion == after);
      }

      function validForce() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let version = request.resource.data.get('forceUpdateVersion', '');
        return (!('forceAllowMetered' in request.resource.data) || request.resource.data.forceAllowMetered is bool)
          && (!changed.hasAny(['updateRequestAt']) || request.resource.data.get('updateRequestAt', null) == request.time)
          && (!changed.hasAny(['forceUpdateVersion', 'forceAllowMetered', 'updateRequestAt']) || version == '' || (
            version == request.resource.data.get('relVersion', '')
            && get(/databases/$(database)/documents/releases/$(version)).data.ready == true
            && get(/databases/$(database)/documents/releases/$(version)).data.pairId == id
            && get(/databases/$(database)/documents/pairs/$(id)/releaseReviews/$(version)).data.state == 'approved'
            && get(/databases/$(database)/documents/pairs/$(id)/releaseReviews/$(version)).data.uid == request.auth.uid
            && get(/databases/$(database)/documents/pairs/$(id)/members/$(request.auth.uid)).data.appVersion == version));
      }

      allow create: if personal()
        && request.resource.data.keys().hasOnly(['members', 'admin', 'code', 'createdAt'])
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.admin == request.auth.uid
        && request.resource.data.code.matches('[0-9]{6}')
        && request.resource.data.createdAt is int;
      allow read: if personal() && request.auth.uid in resource.data.members;
      allow update: if personal() && validMembers(request.resource.data) && validFlags(request.resource.data.get('featureFlags', {})) && (
        // Solo el administrador gestiona miembros y versiones. webUids solo puede borrarse.
        (request.auth.uid in resource.data.members && resource.data.admin == request.auth.uid
          && changedOnly(['members', 'admin', 'code', 'replaced', 'since', 'relVersion', 'relUrl', 'relNotes', 'webUids', 'featureFlags', 'testVersion', 'creatorBrand', 'forceUpdateVersion', 'forceAllowMetered', 'updateRequestAt'])
          && validRelease() && validForce()
          && (!('creatorBrand' in request.resource.data) || (request.resource.data.creatorBrand is string
            && request.resource.data.creatorBrand.size() >= 2 && request.resource.data.creatorBrand.size() <= 60))
          && (!('testVersion' in request.resource.data) || (request.resource.data.testVersion is string
            && get(/databases/$(database)/documents/releases/$(request.resource.data.testVersion)).data.ready == true
            && get(/databases/$(database)/documents/releases/$(request.resource.data.testVersion)).data.pairId == id))
          && (!('relVersion' in resource.data) || ('relVersion' in request.resource.data
            && request.resource.data.relVersion is string && request.resource.data.relVersion.size() > 0))
          && (!('webUids' in request.resource.data) || request.resource.data.webUids == resource.data.get('webUids', []))
          && resource.data.members.hasAll(request.resource.data.members)) ||
        // Ambos pueden cambiar la fecha de la relación.
        (request.auth.uid in resource.data.members && changedOnly(['since'])
          && request.resource.data.since is int) ||
        // Salida voluntaria; el administrador debe transferir primero su rol.
        (request.auth.uid in resource.data.members && resource.data.admin != request.auth.uid
          && changedOnly(['members'])
          && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])) ||
        // Entrar exige código vigente y no permite modificar ningún otro campo.
        (!(request.auth.uid in resource.data.members)
          && resource.data.members.size() == 1
          && request.resource.data.members.size() == 2
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && changedOnly(['members', 'joinCode'])
          && request.resource.data.joinCode == resource.data.code
          && get(/databases/$(database)/documents/codes/$(resource.data.code)).data.pairId == id
          && get(/databases/$(database)/documents/codes/$(resource.data.code)).data.expiresAt > request.time.toMillis())
      );
      function targetFeature(key, uid) {
        let data = pairData(id);
        let mode = data.get('featureFlags', {}).get(key, 'off');
        return mode == 'all' || (mode == 'admin' && data.admin == uid);
      }
      match /appPresence/{uid} {
        allow read: if member(id) && (request.auth.uid == uid || targetFeature('appPresence', uid));
        allow delete: if member(id) && request.auth.uid == uid;
        allow create, update: if member(id) && request.auth.uid == uid
          && request.resource.data.sharing is bool && request.resource.data.updatedAt == request.time
          && ((!request.resource.data.sharing && request.resource.data.keys().hasOnly(['sharing', 'updatedAt']))
            || (request.resource.data.sharing && targetFeature('appPresence', uid)
              && request.resource.data.keys().hasOnly(['sharing', 'label', 'updatedAt'])
              && request.resource.data.label is string && request.resource.data.label.size() <= 100));
      }
      match /sleepPresence/{uid} {
        allow read: if member(id) && (request.auth.uid == uid || targetFeature('sleepStatus', uid));
        allow delete: if member(id) && request.auth.uid == uid;
        allow create, update: if member(id) && request.auth.uid == uid
          && request.resource.data.sharing is bool && request.resource.data.updatedAt == request.time
          && ((!request.resource.data.sharing && request.resource.data.keys().hasOnly(['sharing', 'updatedAt']))
            || (request.resource.data.sharing && targetFeature('sleepStatus', uid)
              && request.resource.data.keys().hasOnly(['sharing', 'state', 'since', 'updatedAt'])
              && request.resource.data.state in ['awake', 'idle', 'sleeping', 'overdue']
              && request.resource.data.since is int && request.resource.data.since >= 0
              && request.resource.data.since <= request.time.toMillis()));
      }
      match /deviceCommands/{uid} {
        allow get: if member(id) && uid in pairData(id).members;
        function newRequest() {
          return member(id) && uid in pairData(id).members && targetFeature('findPhone', uid)
            && get(/databases/$(database)/documents/pairs/$(id)/members/$(uid)).data.get('findPhoneEnabled', false) == true
            && request.resource.data.keys().hasOnly(['requestId', 'requester', 'type', 'createdAt', 'expiresAt', 'status'])
            && request.resource.data.requestId is string && request.resource.data.requestId.matches('[a-zA-Z0-9-]{20,40}')
            && request.resource.data.requester == request.auth.uid && request.resource.data.type == 'ring'
            && request.resource.data.status == 'queued' && request.resource.data.createdAt == request.time
            && request.resource.data.expiresAt is int && request.resource.data.expiresAt > request.time.toMillis()
            && request.resource.data.expiresAt <= request.time.toMillis() + 60000;
        }
        allow create: if newRequest();
        allow update: if (newRequest() && request.time.toMillis() - resource.data.createdAt.toMillis() >= 10000)
          || (member(id) && request.auth.uid == uid && changedOnly(['status', 'handledAt'])
            && request.resource.data.status in ['ringing', 'stopped', 'unavailable']
            && request.resource.data.handledAt == request.time);
      }
      match /members/{uid} {
        allow read: if member(id);
        allow create: if member(id) && uid == request.auth.uid && validProfile(request.resource.data);
        allow update: if member(id) && validProfile(request.resource.data) && (
          uid == request.auth.uid ||
          (uid in pairData(id).members && changedOnly(['liveRequestedUntil'])
            && request.resource.data.liveRequestedUntil is int
            && request.resource.data.liveRequestedUntil <= request.time.toMillis() + 300000
            && request.resource.data.liveRequestedUntil >= request.time.toMillis())
        );
      }
      match /places/{place} {
        allow read: if member(id);
        allow create: if member(id) && request.resource.data.owner == request.auth.uid;
        allow update: if member(id) && request.resource.data.owner == resource.data.owner
          && (resource.data.owner == request.auth.uid || admin(id));
        allow delete: if member(id) && (resource.data.owner == request.auth.uid || admin(id));
      }
      match /events/{event} {
        allow read: if member(id);
        allow create: if member(id) && own(request.resource.data);
      }
      match /trips/{trip} {
        allow read: if member(id);
        allow create: if member(id) && own(request.resource.data);
        allow update: if member(id) && own(resource.data) && changedOnly(['mode']);
      }
      match /visits/{visit} {
        allow read: if member(id);
        allow create: if member(id) && own(request.resource.data);
        allow update: if member(id) && own(resource.data) && changedOnly(['end']);
      }
      match /improvementRequests/{requestId} {
        allow read: if admin(id);
        allow create: if admin(id) && own(request.resource.data)
          && request.resource.data.keys().hasOnly(['uid','text','state','version','createdAt'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.state == 'received'
          && request.resource.data.version is string && request.resource.data.version.size() <= 30
          && request.resource.data.createdAt == request.time;
      }
      match /releaseReviews/{version} {
        allow read: if admin(id);
        allow create, update: if admin(id)
          && request.resource.data.keys().hasOnly(['uid', 'state', 'notes', 'updatedAt'])
          && own(request.resource.data) && request.resource.data.state in ['approved', 'changes_requested']
          && request.resource.data.notes is string && request.resource.data.notes.size() <= 2000
          && request.resource.data.updatedAt == request.time
          && get(/databases/$(database)/documents/releases/$(version)).data.ready == true
          && get(/databases/$(database)/documents/releases/$(version)).data.pairId == id
          && (request.resource.data.state != 'approved' ||
            get(/databases/$(database)/documents/pairs/$(id)/members/$(request.auth.uid)).data.appVersion == version);
      }
      match /voiceNotes/{note} {
        allow read: if member(id) && feature(id, 'voiceNotes', 'off');
        allow create: if member(id) && feature(id, 'voiceNotes', 'off') && own(request.resource.data)
          && request.resource.data.keys().hasOnly(['uid', 'audio', 'durationMs', 'createdAt'])
          && request.resource.data.audio is bytes && request.resource.data.audio.size() <= 150000
          && request.resource.data.audio.size() > 0
          && request.resource.data.durationMs is int
          && request.resource.data.durationMs >= 300 && request.resource.data.durationMs <= 30000
          && request.resource.data.createdAt == request.time;
        allow delete: if member(id) && (own(resource.data) || admin(id));
      }
      match /walkiePresence/{uid} {
        allow read: if member(id) && feature(id, 'walkieRelay', 'off');
        allow create, update: if member(id) && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['relay', 'protocol', 'updatedAt'])
          && request.resource.data.relay is bool && request.resource.data.protocol == 'walkie-amrnb-v1'
          && request.resource.data.updatedAt == request.time
          && (!request.resource.data.relay || (feature(id, 'walkie', 'off') && feature(id, 'walkieRelay', 'off')));
      }
      match /walkiePackets/{packet} {
        function participant() { return resource.data.uid == request.auth.uid || resource.data.to == request.auth.uid; }
        function optedIn(uid) {
          let consent = get(/databases/$(database)/documents/pairs/$(id)/walkiePresence/$(uid)).data;
          return consent.relay == true && consent.protocol == 'walkie-amrnb-v1'
            && consent.updatedAt.toMillis() >= request.time.toMillis() - 480000;
        }
        allow read: if member(id) && feature(id, 'walkie', 'off') && feature(id, 'walkieRelay', 'off') && participant();
        allow delete: if member(id) && participant();
        allow create: if member(id) && feature(id, 'walkie', 'off') && feature(id, 'walkieRelay', 'off')
          && own(request.resource.data) && request.resource.data.to in pairData(id).members
          && request.resource.data.to != request.auth.uid && targetFeature('walkieRelay', request.resource.data.to)
          && targetFeature('walkie', request.resource.data.to)
          && optedIn(request.auth.uid) && optedIn(request.resource.data.to)
          && request.resource.data.keys().hasOnly(['uid', 'to', 'audio', 'createdAt', 'expiresAt'])
          && request.resource.data.audio is bytes && request.resource.data.audio.size() > 0 && request.resource.data.audio.size() <= 4096
          && request.resource.data.createdAt == request.time && request.resource.data.expiresAt is int
          && request.resource.data.expiresAt > request.time.toMillis()
          && request.resource.data.expiresAt <= request.time.toMillis() + 15000;
      }
      match /walkieCalls/{call} {
        function participant() { return member(id) && request.auth.uid in [resource.data.uid, resource.data.to]; }
        allow read: if member(id) && feature(id, 'walkie', 'off');
        allow delete: if participant();
        allow create: if member(id) && feature(id, 'walkie', 'off') && own(request.resource.data)
          && request.resource.data.keys().hasOnly(['uid', 'to', 'offer', 'createdAt'])
          && request.resource.data.to in pairData(id).members
          && request.resource.data.to != request.auth.uid
          && request.resource.data.offer is string && request.resource.data.offer.size() <= 32000
          && request.resource.data.createdAt == request.time;
        allow update: if participant() && feature(id, 'walkie', 'off') && request.auth.uid == resource.data.to
          && !('answer' in resource.data) && changedOnly(['answer'])
          && request.resource.data.answer is string && request.resource.data.answer.size() <= 32000;
        match /candidates/{candidate} {
          function callData() { return get(/databases/$(database)/documents/pairs/$(id)/walkieCalls/$(call)).data; }
          function participant() { return member(id) && request.auth.uid in [callData().uid, callData().to]; }
          allow read: if participant() && feature(id, 'walkie', 'off');
          allow delete: if participant();
          allow create: if participant() && feature(id, 'walkie', 'off') && own(request.resource.data)
            && request.resource.data.keys().hasOnly(['uid', 'candidate', 'mid', 'line'])
            && request.resource.data.candidate is string && request.resource.data.candidate.size() <= 4096
            && request.resource.data.mid is string && request.resource.data.mid.size() <= 128
            && request.resource.data.line is int && request.resource.data.line >= 0 && request.resource.data.line <= 32;
        }
      }
      match /photos/{photo} {
        allow read: if member(id);
        allow create: if member(id) && own(request.resource.data);
        allow delete: if member(id) && (own(resource.data) || admin(id));
        match /full/{image} {
          allow read: if member(id);
          allow create: if member(id) && image == 'img'
            && getAfter(/databases/$(database)/documents/pairs/$(id)/photos/$(photo)).data.uid == request.auth.uid;
          allow delete: if member(id) && (
            get(/databases/$(database)/documents/pairs/$(id)/photos/$(photo)).data.uid == request.auth.uid || admin(id));
        }
      }
    }
  }
}
