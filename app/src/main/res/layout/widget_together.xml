<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp"
    android:background="@drawable/widget_bg_night">
    <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#C9D1DC" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/w_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#F9A8D4" android:textSize="30sp" android:textStyle="bold" android:maxLines="1"/>
    <TextView android:id="@+id/w_detail" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#F1F5F9" android:textSize="12sp" android:maxLines="3"/>
</LinearLayout>
