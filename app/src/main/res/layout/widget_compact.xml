<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="8dp"
    android:background="@drawable/widget_bg_night">
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:text="Nosotros" android:textColor="#F1F5F9" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/w_value" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:text="—" android:textColor="#5EEAD4" android:textSize="20sp" android:textStyle="bold"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="24sp" android:autoSizeStepGranularity="1sp" android:maxLines="1"/>
    <TextView android:id="@+id/w_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="#C9D1DC" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
